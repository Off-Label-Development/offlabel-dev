---
import { siteConfig } from '../config/site';
---

<footer class="py-8 border-t border-border/50">
  <div class="container flex flex-col items-center gap-4 md:flex-row md:justify-between">
    <p class="text-sm text-muted-foreground">
      © {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
    </p>
    <div class="flex items-center gap-6">
      <a href="mailto:hello@offlabel.dev" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
        Contact
      </a>
      <a href="/privacy" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
        Privacy
      </a>
      <a href="/terms" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
        Terms
      </a>
    </div>
  </div>
</footer>