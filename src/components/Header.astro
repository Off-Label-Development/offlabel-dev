---
import { siteConfig } from '../config/site';
---

<header class="fixed top-0 left-0 right-0 z-sticky bg-background border-b border-border/50">
  <nav class="container flex items-center justify-between py-4">
    <a href="/" class="font-serif text-2xl font-bold text-primary tracking-tight hover:text-accent transition-colors" aria-label={siteConfig.name}>
      Off-Label
    </a>
    <ul class="hidden md:flex items-center gap-8">
      <li>
        <a href="/about" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
          About
        </a>
      </li>
      <li>
        <a href="/services" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
          Services
        </a>
      </li>
      <li>
        <a href="/team" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
          Our Team
        </a>
      </li>
    </ul>
    <a href="/contact" class="md:hidden btn btn-primary text-sm">
      Contact
    </a>
  </nav>
</header>