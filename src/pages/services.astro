---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
---

<Layout>
  <section class="pt-32 pb-20 px-6">
    <div class="container">
      <div class="text-center mb-16">
        <h1 class="font-serif text-4xl font-medium text-foreground md:text-5xl text-balance">
          Services
        </h1>
        <p class="mt-4 text-lg text-muted-foreground max-w-2xl mx-auto">
          Every business is different. Here are the ways we typically work with small businesses like yours.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 mb-16">
        <article class="group bg-card rounded-[var(--radius)] p-8 border border-border/50 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/5 transition-all">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-secondary text-primary mb-4 group-hover:bg-primary/10 transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5} aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
            </svg>
          </div>
          <h2 class="text-xl font-semibold text-foreground">AI Strategy Sessions</h2>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            One-on-one sessions to identify where AI can help your business. We cut through the noise and find practical opportunities.
          </p>
          <ul class="mt-6 space-y-2 text-sm text-muted-foreground">
            <li class="flex gap-2"><span class="text-primary">✓</span> 90-minute discovery call</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> Current workflow audit</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> Ranked opportunity list with ROI estimates</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> 30-day implementation roadmap</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> Follow-up check-in at 2 weeks</li>
          </ul>
          <div class="mt-6 pt-6 border-t border-border">
            <p class="font-semibold text-foreground">Starting at $2,500</p>
          </div>
        </article>

        <article class="group bg-card rounded-[var(--radius)] p-8 border border-border/50 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/5 transition-all">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-secondary text-primary mb-4 group-hover:bg-primary/10 transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5} aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" d="M4.5 12a7.5 7.5 0 0 0 15 0m-15 0a7.5 7.5 0 1 1 15 0m-15 0H3m16.5 0H21m-1.5 0H12m-8.457 3.077 1.41-.513m14.095-5.13 1.41-.513M5.106 17.785l1.15-.964m11.49-9.642 1.149-.964M7.501 19.795l.75-1.3m7.5-12.99.75-1.3m-6.063 16.658.26-1.477m2.605-14.772.26-1.477m0 17.726-.26-1.477M10.698 4.614l-.26-1.477M16.5 19.794l-.75-1.299M7.5 4.205 12 12m6.894 5.785-1.149-.964M6.256 7.178l-1.15-.964m15.352 8.864-1.41-.513M4.954 9.435l-1.41-.514M12.002 12l-3.75 6.495" />
            </svg>
          </div>
          <h2 class="text-xl font-semibold text-foreground">Workflow Automation</h2>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            We help you automate repetitive tasks — from email sorting to invoice processing — so you can focus on what matters.
          </p>
          <ul class="mt-6 space-y-2 text-sm text-muted-foreground">
            <li class="flex gap-2"><span class="text-primary">✓</span> Process mapping & bottleneck identification</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> Custom automation build (n8n, Zapier, or code)</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> Integration with your existing tools</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> Testing & documentation</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> 30 days of support & iteration</li>
          </ul>
          <div class="mt-6 pt-6 border-t border-border">
            <p class="font-semibold text-foreground">Project-based pricing</p>
          </div>
        </article>

        <article class="group bg-card rounded-[var(--radius)] p-8 border border-border/50 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/5 transition-all">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-secondary text-primary mb-4 group-hover:bg-primary/10 transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5} aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
            </svg>
          </div>
          <h2 class="text-xl font-semibold text-foreground">Team Training</h2>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            Hands-on workshops that demystify AI for your team. We teach practical skills, not theory — so everyone can contribute.
          </p>
          <ul class="mt-6 space-y-2 text-sm text-muted-foreground">
            <li class="flex gap-2"><span class="text-primary">✓</span> Half-day or full-day workshops</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> Tailored to your industry & tools</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> Live demos with your actual workflows</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> Prompt library & cheat sheets included</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> 60-day Slack support for questions</li>
          </ul>
          <div class="mt-6 pt-6 border-t border-border">
            <p class="font-semibold text-foreground">Starting at $3,000/day</p>
          </div>
        </article>

        <article class="group bg-card rounded-[var(--radius)] p-8 border border-border/50 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/5 transition-all">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-secondary text-primary mb-4 group-hover:bg-primary/10 transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5} aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
            </svg>
          </div>
          <h2 class="text-xl font-semibold text-foreground">Custom Solutions</h2>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            Need something specific? We build tailored AI tools that solve your unique challenges — designed for simplicity.
          </p>
          <ul class="mt-6 space-y-2 text-sm text-muted-foreground">
            <li class="flex gap-2"><span class="text-primary">✓</span> Custom GPTs, agents, or RAG systems</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> Internal knowledge bases & search</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> Document processing pipelines</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> Self-hosted or cloud deployment</li>
            <li class="flex gap-2"><span class="text-primary">✓</span> Ongoing maintenance available</li>
          </ul>
          <div class="mt-6 pt-6 border-t border-border">
            <p class="font-semibold text-foreground">Discovery call required</p>
          </div>
        </article>
      </div>

      <div class="bg-secondary/50 rounded-[var(--radius)] p-8 md:p-12 text-center">
        <h2 class="font-serif text-2xl font-medium text-foreground md:text-3xl">
          Not sure where to start?
        </h2>
        <p class="mt-3 text-muted-foreground max-w-xl mx-auto">
          Most clients begin with an AI Strategy Session. It's the fastest way to get clarity and a concrete plan.
        </p>
        <a href="/contact" class="mt-6 inline-block btn btn-primary">
          Book a Strategy Session
        </a>
      </div>
    </div>
  </section>
</Layout>