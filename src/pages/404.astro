---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
---

<Layout>
  <section class="pt-32 pb-20 px-6 min-h-[60vh] flex items-center justify-center">
    <div class="container text-center">
      <h1 class="font-serif text-6xl md:text-8xl font-medium text-primary/20">404</h1>
      <h2 class="mt-4 font-serif text-3xl font-medium text-foreground md:text-4xl">
        Page Not Found
      </h2>
      <p class="mt-4 text-lg text-muted-foreground max-w-xl mx-auto">
        Sorry, we couldn't find the page you're looking for. It might have been moved or doesn't exist.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="btn btn-primary">
          Go Home
        </a>
        <a href="/contact" class="btn btn-secondary">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Layout>