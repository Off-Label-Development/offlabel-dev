---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
---

<Layout>
  <section class="pt-32 pb-20 px-6">
    <div class="container max-w-3xl">
      <h1 class="font-serif text-4xl font-medium text-foreground md:text-5xl text-balance">
        About Off-Label Development
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
        Off-Label Development was founded on a simple observation: small businesses are
        being left behind in the AI revolution. While enterprises have teams of data
        scientists and ML engineers, most small businesses are told to "just use ChatGPT"
        or buy expensive tools that don't fit their workflow.
      </p>

      <div class="mt-12 space-y-8">
        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">
            Our Philosophy
          </h2>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            The term "off-label" comes from medicine — using an approved drug for a
            condition it wasn't originally prescribed for. Often, these off-label uses
            become standard practice because practitioners on the ground discover
            practical applications that clinical trials missed.
          </p>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            We apply the same thinking to AI. The big models and platforms are the
            "approved drugs" — powerful, general, but not designed for your specific
            business. Our job is finding the off-label uses that actually work for you:
            the prompt patterns, the workflow integrations, the automations that save
            hours every week.
          </p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">
            What We Believe
          </h2>
          <ul class="mt-4 space-y-3 text-muted-foreground leading-relaxed">
            <li class="flex gap-3">
              <span class="text-primary font-bold">→</span>
              <span>AI should amplify human judgment, not replace it</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">→</span>
              <span>The best solution is the one your team will actually use</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">→</span>
              <span>Small businesses deserve the same quality of AI as enterprises</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">→</span>
              <span>Practical beats theoretical every time</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">→</span>
              <span>Trust is earned through results, not marketing</span>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">
            Our Founder
          </h2>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            <strong>Nicholas Dana, PhD</strong> — Quantitative researcher, software
            engineer, and former biotech consultant. After a decade building
            data-driven systems for pharmaceutical companies and hedge funds, he
            started Off-Label Development to bring that same rigor to small business AI.
          </p>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            He's the author of several open-source tools for AI evaluation and
            quantitative trading, and occasionally writes at
            <a href="https://phronesix.com" class="text-primary hover:underline">phronesix.com</a>.
          </p>
        </div>
      </div>

      <div class="mt-12 p-8 bg-secondary/50 rounded-[var(--radius)] text-center">
        <h2 class="font-serif text-2xl font-medium text-foreground">
          Ready to see what AI can do for your business?
        </h2>
        <p class="mt-3 text-muted-foreground">
          Start with a conversation — no pressure, no pitch.
        </p>
        <a href="/contact" class="mt-6 inline-block btn btn-primary">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</Layout>