---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
---

<Layout>
  <section class="pt-32 pb-20 px-6">
    <div class="container max-w-3xl">
      <h1 class="font-serif text-4xl font-medium text-foreground md:text-5xl text-balance">
        Privacy Policy
      </h1>
      <p class="mt-4 text-muted-foreground">
        Last updated: {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>

      <div class="mt-12 space-y-8 text-muted-foreground leading-relaxed">
        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">1. Information We Collect</h2>
          <p class="mt-3">We collect information you provide directly to us:</p>
          <ul class="mt-3 space-y-2 list-disc list-inside">
            <li>Name, email, and company when you fill out our contact form</li>
            <li>Email address when you subscribe to our newsletter</li>
            <li>Any information you choose to share in messages to us</li>
          </ul>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">2. How We Use Your Information</h2>
          <p class="mt-3">We use the information we collect to:</p>
          <ul class="mt-3 space-y-2 list-disc list-inside">
            <li>Respond to your inquiries and provide requested services</li>
            <li>Send our newsletter (only if you subscribed)</li>
            <li>Improve our website and services</li>
            <li>Comply with legal obligations</li>
          </ul>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">3. Information Sharing</h2>
          <p class="mt-3">We do not sell your personal information. We may share information with:</p>
          <ul class="mt-3 space-y-2 list-disc list-inside">
            <li>Service providers who operate our website (Formspree for forms, Cloudflare for hosting/analytics)</li>
            <li>Legal authorities when required by law</li>
          </ul>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">4. Analytics</h2>
          <p class="mt-3">We use Cloudflare Web Analytics, which is privacy-first — no cookies, no personal data collection, no tracking across sites. It provides aggregate traffic insights only.</p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">5. Your Rights</h2>
          <p class="mt-3">Depending on your location, you may have rights to access, correct, delete, or restrict processing of your data. Contact us at <a href="mailto:hello@offlabel.dev" class="text-primary hover:underline">hello@offlabel.dev</a> to exercise these rights.</p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">6. Contact Us</h2>
          <p class="mt-3">Questions about this policy? Email <a href="mailto:hello@offlabel.dev" class="text-primary hover:underline">hello@offlabel.dev</a>.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>