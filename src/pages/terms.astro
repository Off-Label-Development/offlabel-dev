---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
---

<Layout>
  <section class="pt-32 pb-20 px-6">
    <div class="container max-w-3xl">
      <h1 class="font-serif text-4xl font-medium text-foreground md:text-5xl text-balance">
        Terms of Service
      </h1>
      <p class="mt-4 text-muted-foreground">
        Last updated: {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>

      <div class="mt-12 space-y-8 text-muted-foreground leading-relaxed">
        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">1. Acceptance of Terms</h2>
          <p class="mt-3">By accessing and using offlabel.dev, you accept and agree to be bound by these Terms of Service. If you do not agree, do not use this site.</p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">2. Services Description</h2>
          <p class="mt-3">Off-Label Development provides AI consulting, strategy, automation, training, and custom development services for small businesses. Specific engagements are governed by separate agreements.</p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">3. Use of This Website</h2>
          <p class="mt-3">You agree to use this website only for lawful purposes and in accordance with these Terms. You may not:</p>
          <ul class="mt-3 space-y-2 list-disc list-inside">
            <li>Violate any applicable law or regulation</li>
            <li>Interfere with or disrupt the website's operation</li>
            <li>Attempt to gain unauthorized access to any systems</li>
            <li>Use automated tools to scrape or extract content without permission</li>
          </ul>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">4. Intellectual Property</h2>
          <p class="mt-3">All content on this site (text, graphics, logos, code) is the property of Off-Label Development or its licensors, protected by copyright and trademark law. You may not reproduce, distribute, or create derivative works without written permission.</p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">5. No Professional Advice</h2>
          <p class="mt-3">Content on this website is for informational purposes only and does not constitute professional business, legal, or technical advice. Consult qualified professionals for your specific situation.</p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">6. Limitation of Liability</h2>
          <p class="mt-3">To the maximum extent permitted by law, Off-Label Development shall not be liable for any indirect, incidental, special, consequential, or punitive damages, or any loss of profits or revenues, whether incurred directly or indirectly.</p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">7. Indemnification</h2>
          <p class="mt-3">You agree to indemnify and hold Off-Label Development harmless from any claims, damages, or expenses arising from your use of this website or violation of these Terms.</p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">8. Governing Law</h2>
          <p class="mt-3">These Terms are governed by the laws of the State of Colorado, USA, without regard to conflict of law principles.</p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">9. Changes to Terms</h2>
          <p class="mt-3">We may update these Terms at any time. Changes are effective when posted. Your continued use constitutes acceptance.</p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-medium text-foreground">10. Contact Us</h2>
          <p class="mt-3">Questions about these Terms? Email <a href="mailto:hello@offlabel.dev" class="text-primary hover:underline">hello@offlabel.dev</a>.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>